{
  "name": "geriatric-app-backend",
  "version": "1.0.0",
  "description": "Backend API REST para Sistema de Gestión de Hogares Geriátricos",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev-message.js && node --watch src/server.js",
    "init-db": "node scripts/initDatabase.js",
    "reset-db": "node scripts/resetDatabase.js",
    "create-users": "node scripts/createUsers.js",
    "create-patients": "node scripts/createTestPatients.js",
    "test-connection": "node scripts/testConnection.js",
    "hash-passwords": "node scripts/hashPasswords.js",
    "test": "node scripts/testApi.js",
    "test-api": "node scripts/testApi.js",
    "seed-clinico": "node -e \"import('./scripts/seedData.js').then(async m=>{const {default:pg}=await import('pg');const {env}=await import('./src/config/env.js');const c=new pg.Client(env.db);await c.connect();await m.seedClinico(c);await c.end();})\""
  },
  "keywords": [
    "api",
    "rest",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
  "description": "Backend API REST para Sistema de Gestión de Hogares Geriátricos",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev-message.js && node --watch src/server.js",
    "init-db": "node scripts/initDatabase.js",
    "reset-db": "node scripts/resetDatabase.js",
    "create-users": "node scripts/createUsers.js",
